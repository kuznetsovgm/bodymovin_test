# Telegram Bot Token
BOT_TOKEN=your_bot_token_here

# Redis Configuration
REDIS_URL=redis://localhost:6379

# Postgres Configuration (used for storing users via TypeORM)
PG_HOST=localhost
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=postgres
PG_DB=postgres
# Set to true to let TypeORM auto-create tables (useful for local dev; keep false in prod with migrations)
PG_SYNC=false

# Admin User IDs (comma-separated)
# These users can manage sticker configurations
ADMIN_USER_IDS=123456789

# Environment
NODE_ENV=production

# Logging Configuration
LOG_LEVEL=info
ENABLE_LOKI=true
# If Loki runs in external compose, attach bot to network `quickqueue-shared`
# and keep service DNS name from that network (example: loki:3100).
LOKI_HOST=http://loki:3100

# Metrics Configuration
METRICS_PORT=3099
# Bot metrics are exposed on host port 3099 by default.

# Grafana Configuration
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# Debounce delay for inline queries (milliseconds)
DEBOUNCE_DELAY=2000

# Inline sticker generation/output pipeline
# Number of variants started for each uncached inline query batch
STICKERS_PER_GENERATION_BATCH=10
# Number of fully cached stickers returned per page
STICKERS_PER_PAGE_CACHED=20
# Maximum time to wait for the first generated+uploaded result before answering
INLINE_FIRST_RESULT_WAIT_MS=7000
# Keep active in-memory generation jobs for repeated Telegram inline queries
ACTIVE_STICKER_JOB_TTL_MS=300000
MAX_ACTIVE_STICKER_JOBS=50

# Telegram upload throttling
# Uploads are always serialized; this adds a gap between upload attempts
UPLOAD_MIN_INTERVAL_MS=0
MAX_UPLOAD_QUEUE_SIZE=100

# Worker Pool Configuration
# Number of worker threads for parallel sticker generation (default: CPU count)
WORKER_POOL_SIZE=4
# Maximum number of tasks in the worker queue (default: 100)
WORKER_QUEUE_SIZE=100

# Config UI Protection
# Prefix for accessing the configuration UI (e.g. /my-secret-ui). Must start with '/'.
CONFIG_UI_SECRET_PATH=/config-ui-secret
